# Generated by Cargo
/target/

# Tauri build artefacts
**/tauri/target/

# Node
node_modules/
dist/
.vite/

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp

# Local config (API keys live in OS keyring, but config.json may have non-secret bits)
*.local.json

# Line Desktop MCP vendored copy
bundled/line-desktop-mcp/node_modules/
# v0.6.7: the clone now lives under crates/line-hub-tauri/vendor/ so it
# is a sibling of tauri.conf.json — this lets `bundle.resources` source
# paths resolve identically under tauri-build (manifest-dir CWD) and the
# NSIS bundler (target/release/nsis/<arch>/ CWD). Git clone is cheap;
# checking in the ~5 MB vendored sources would create churn every time
# upstream bumps.
/vendor/
/crates/*/vendor/
/crates/**/vendor/

# v0.6.1: scripts/nsis-hooks.nsh build artefact.
/scripts/*.bak
